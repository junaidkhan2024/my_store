<h1>Products</h1>
<nav>
	<%= link_to "New product", new_product_path if authenticated? %>
</nav>

<div id="products">
  <% @products.each do | product | %>
		<div>
			<h2> <%= link_to product.name, product_path(product.id) %> </h2>
		</div>
	<%end%>
</div>		

<nav>
	<%= link_to "Login", new_session_path unless authenticated? %>
</nav>
